# Copie para .env e preencha. Nunca versionar o arquivo .env.

PORT=8080
HOST=127.0.0.1

# Autenticação. Produção: defina FIREBASE_PROJECT_ID.
# Teste local sem login real: AUTH_MODE=guest (aviso explícito no log).
AUTH_MODE=
FIREBASE_PROJECT_ID=
# Chave web pública do app Firebase (entregue ao navegador).
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
# Credencial da conta de serviço, em JSON numa linha. Opcional se o ambiente já
# fornecer credenciais padrão (GOOGLE_APPLICATION_CREDENTIALS). Nunca commitar.
FIREBASE_SERVICE_ACCOUNT_JSON=

# PostgreSQL. Sem esta variável o histórico fica em memória.
DATABASE_URL=
